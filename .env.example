NODE_ENV=development
API_PORT=4000
TRUST_PROXY_HOPS=0
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/design_to_elementor
JWT_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET_MIN_32_CHARACTERS

UPLOAD_MAX_BYTES=524288000
UPLOAD_QUOTA_BYTES=2147483648
LOCAL_STORAGE_PATH=./storage/uploads
STORAGE_PROVIDER=local

B2_BUCKET_NAME=design-to-elementor
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=

AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
ENABLE_GEMINI=true
GEMINI_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
AI_REQUEST_TIMEOUT_MS=60000

SITE_CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CONVERSION_WORKER_CONCURRENCY=2
CONVERSION_MAX_ATTEMPTS=3

# Optional stage-role settings
VISION_AI_PROVIDER=gemini
VISION_AI_MODEL=gemini-3.8-flash
STRUCTURE_AI_PROVIDER=groq
STRUCTURE_AI_MODEL=openai/gpt-oss-120b
REVIEW_AI_PROVIDER=openrouter
REVIEW_AI_MODEL=anthropic/claude-3.5-sonnet
RUN_LIVE_AI_TESTS=false
